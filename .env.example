# Copy this file to .env and fill in your key.

# Default: Google Gemini free tier (create a key at https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=AIza...
LLM_MODEL=gemini-3.5-flash-lite   # fast and reliable; gemini-3.8-flash is stronger but slower and sometimes overloaded
EMBEDDING_MODEL=gemini-embedding-001
LOG_LEVEL=INFO                    # DEBUG to see tool arguments and results in full
LOG_DIR=logs                      # rotating log file (5 x 5 MB); leave empty to log to stdout only

# Alternative: Groq free tier (https://console.groq.com). Very fast, but only 8K tokens per minute.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=            # Groq has no embedding models; leave empty to skip the aspect-merging step

# Alternative: local Ollama (run `ollama pull llama3.1:8b` first). No key, no limits, needs 8 GB of RAM.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# EMBEDDING_MODEL=nomic-embed-text   # run `ollama pull nomic-embed-text` first
